# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Voice for users tracked without picking one. Voice IDs look like
# <engine>_<language>_<male|female>_<name>, e.g. piper_pt-br_male_faber;
# see VOICES in bot/tts.py (or the /overvoice track autocomplete).
TTS_DEFAULT_VOICE=kokoro_en-us_female_heart

# Messages longer than this are truncated before being spoken
TTS_MAX_CHARS=500

# Optional: set to save every generated clip as a .wav file in this
# directory (inside the container) for troubleshooting.
# TTS_DEBUG_DIR=/app/debug-audio

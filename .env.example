# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Default TTS language/voice for servers that haven't set their own via
# the /overvoice language and /overvoice voice commands.
TTS_DEFAULT_LANGUAGE=english
TTS_DEFAULT_VOICE=alba

# Messages longer than this are truncated before being spoken
TTS_MAX_CHARS=500

# Optional: set to save every generated clip as a .wav file under
# ./debug-audio (mounted by docker-compose.yml) for troubleshooting.
TTS_DEBUG_DIR=/app/debug-audio

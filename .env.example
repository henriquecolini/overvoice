# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Default Kokoro voice for servers that haven't run /overvoice voice yet.
# See bot/tts.py's VOICES list for every option (language is implied by
# the voice's own prefix, e.g. pf_dora speaks Brazilian Portuguese).
TTS_DEFAULT_VOICE=af_heart

# Messages longer than this are truncated before being spoken
TTS_MAX_CHARS=500

# Optional: set to save every generated clip as a .wav file in this
# directory (inside the container) for troubleshooting.
# TTS_DEBUG_DIR=/app/debug-audio
